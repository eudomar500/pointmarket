# Copy this file to .env and fill in your values.
# NEVER commit the .env file.

# --- GenLayer Network --------------------------------------------------

# Network to deploy to: localnet | testnet-asimov | testnet-bradbury
GENLAYER_NETWORK=localnet

# Your private key for testnet deployments.
# For local Studio, the faucet provides funded accounts - leave blank.
# IMPORTANT: never commit a key that has been funded with real value.
GENLAYER_PRIVATE_KEY=

# RPC endpoint (auto-detected if you use the network names above)
GENLAYER_RPC_URL=

# --- Frontend ----------------------------------------------------------

# Addresses of deployed factory contracts, filled in after deployment
NEXT_PUBLIC_MARKETPLACE_FACTORY=
NEXT_PUBLIC_PREDICTION_FACTORY=

NEXT_PUBLIC_NETWORK=localnet
