# Evidence photo pinning (app/api/pin/route.ts), server side only.
# These have no NEXT_PUBLIC_ prefix on purpose: Next.js never ships them to
# the browser. Put real values in .env.local, never in this file.
#
# Filebase free plan: create an IPFS bucket and an S3 access key pair in the
# Filebase console. Uploads go through the S3-compatible API, not the paid
# Pinning Service API.
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=
# Optional, defaults to https://s3.filebase.com
FILEBASE_ENDPOINT=
