# Pointmarket frontend environment variables

# Default network the dApp targets. One of: studionet, testnetAsimov, testnetBradbury.
NEXT_PUBLIC_DEFAULT_NETWORK=studionet

# Optional: custom RPC endpoint. Leave blank to use the SDK's default for each chain.
# NEXT_PUBLIC_STUDIONET_RPC=https://studio.genlayer.com:8443/api
